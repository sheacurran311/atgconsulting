// Prisma schema for ATG Consulting
// Provider: PostgreSQL (Replit Postgres / Neon / Supabase / any Postgres URL).
// For local dev with SQLite: change provider back to "sqlite" and set
// DATABASE_URL="file:./prisma/dev.db" in .env.local (not committed).
// All String fields map to TEXT in Postgres (no length limits).
// JSON data is stored serialised as text (no Json type used) for portability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ───────────────────────────────────────────────────────────────────────

/// Auth provider identity (Clerk, dev, etc.). A User can have multiple identities.
model AuthIdentity {
  id             String   @id @default(cuid())
  provider       String   // "clerk" | "dev"
  providerUserId String   // stable id from the provider (Clerk user id, etc.)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model User {
  id          String       @id @default(cuid())
  email       String?      @unique // lowercased; null if provider didn't supply one
  name        String?
  imageUrl    String?
  role        String       @default("CLIENT") // CLIENT | ADMIN
  createdAt   DateTime     @default(now())
  lastLoginAt DateTime?

  identities  AuthIdentity[]
  client      Client?
  auditLogs   AuditLog[]
  moduleProgress ModuleProgress[]
}

// ── Client profile ─────────────────────────────────────────────────────────────

model Client {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  company           String?
  roleTitle         String?
  industry          String?
  size              String?  // solo|2-10|11-50|50+
  tier              String   @default("NONE") // NONE|SELF_SERVE|GUIDED|WHITE_GLOVE
  aiLevel           Int      @default(0) // 0–4
  areas             String   @default("[]") // JSON array
  status            String   @default("PROSPECT") // PROSPECT|ACTIVE|PAUSED|CHURNED
  helpStyle         String?  // self_serve|guided|done_for_you|not_sure (from intake)
  digestEmailOptIn  Boolean  @default(true)
  stripeCustomerId  String?
  notes             String?  // admin-only markdown notes

  // ── Guided session package ──────────────────────────────────────────────────
  guidedSessionsTotal Int?    // total sessions in their package
  guidedSessionsUsed  Int     @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  intakes           Intake[]
  plans             Plan[]
  workflowItems     WorkflowItem[]
  consultations     Consultation[]
  documents         Document[]
  reports           Report[]
  workflows         Workflow[]
  outputItems       OutputItem[]
  messages          ClientMessage[]
  workflowRequests  WorkflowRequest[]
  toolPlans         ToolPlan[]
  dfyApplication    DfyApplication?
  supportTickets    SupportTicket[]
  playbooks         ClientPlaybook[]
  sessionRecords    SessionRecord[]
}

// ── Intake ─────────────────────────────────────────────────────────────────────

model Intake {
  id          String   @id @default(cuid())
  email       String
  name        String
  answers     String   // JSON (versioned intake payload)
  areas       String   // JSON array
  aiComfort   Int
  hoursLost   Int
  helpStyle   String

  // ── New intake fields (nullable for backward compat) ────────────────────────
  /// Monthly tool budget range, e.g. "<$50/mo"
  toolBudget       String?
  /// Current software by name (free text, optional)
  currentSoftware  String?
  /// Weekly volumes, e.g. "10-50/wk"
  weeklyVolumes    String?

  ipHash      String?
  userAgent   String?
  status      String   @default("NEW") // NEW|REVIEWED|CONVERTED|SPAM
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  createdAt   DateTime @default(now())

  plans       Plan[]
  toolPlans   ToolPlan[]
  playbooks   ClientPlaybook[]
}

// ── Plan ──────────────────────────────────────────────────────────────────────

model Plan {
  id                String   @id @default(cuid())
  intakeId          String
  intake            Intake   @relation(fields: [intakeId], references: [id])
  clientId          String?
  client            Client?  @relation(fields: [clientId], references: [id])

  // ── Client-facing snapshot (short — no implementation details) ──────────────
  // What the client sees after intake: readiness level + 2-3 focus areas + CTA.
  // NEVER includes tool setups, step-by-step instructions, or implementation plans.
  aiReadinessLabel  String   // e.g. "Early Explorer", "Occasional User", "Active Builder"
  aiReadinessSummary String  // 2-3 plain-language sentences about where they are today
  focusAreas        String   // JSON: [{area, name, whyItMatters}] — 2-3 areas, one-line each
  recommendedTier   String   // self_serve|guided|done_for_you
  tierRationale     String   // 1-2 sentences, no implementation details
  ctaText           String   // strong CTA to book 1:1 with Shea

  // ── Admin pre-call report (internal only) ───────────────────────────────────
  // Full intelligence report for Shea: situation, pains, opportunities, talking
  // points, objections, discovery questions, risks, recommended scope, next steps.
  // Visible only to admins. Never shown to clients.
  adminReport       String?  // JSON: AdminPreCallReport
  adminReportPdfId  String?  // Document.id for the admin PDF

  // ── Metadata ────────────────────────────────────────────────────────────────
  source            String   @default("TEMPLATE") // LLM|TEMPLATE
  model             String?
  promptVersion     String?
  pdfDocumentId     String?  // client-facing PDF

  createdAt         DateTime @default(now())

  workflowItems     WorkflowItem[]
}

// ── Workflow checklist ────────────────────────────────────────────────────────

model WorkflowItem {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planId    String?
  plan      Plan?    @relation(fields: [planId], references: [id])
  area      String
  title     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Consultations ─────────────────────────────────────────────────────────────

model Consultation {
  id            String       @id @default(cuid())
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime?
  durationMin   Int          @default(60)
  title         String
  notes         String?      // markdown
  recordingUrl  String?
  status        String       @default("SCHEDULED") // SCHEDULED|COMPLETED|CANCELLED
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  actionItems   ActionItem[]
}

model ActionItem {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  owner          String       @default("CLIENT") // CLIENT|ADMIN
  text           String
  done           Boolean      @default(false)
  dueAt          DateTime?
  createdAt      DateTime     @default(now())
}

// ── Documents ─────────────────────────────────────────────────────────────────

model Document {
  id               String   @id @default(cuid())
  clientId         String?  // null = shared library
  client           Client?  @relation(fields: [clientId], references: [id])
  title            String
  type             String   @default("OTHER") // PLAN|ONE_PAGER|WORKFLOW|SESSION|OTHER
  storageKey       String
  mime             String
  size             Int
  visibleToClient  Boolean  @default(true)
  minTier          String?  // null = any tier
  uploadedById     String?  // admin user id
  createdAt        DateTime @default(now())
}

// ── Reports ───────────────────────────────────────────────────────────────────

model Report {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date            String    // YYYY-MM-DD
  kind            String    @default("DAILY")
  contentMarkdown String
  data            String    @default("{}") // JSON
  status          String    @default("DRAFT") // DRAFT|PUBLISHED
  publishedAt     DateTime?
  emailedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([clientId, date, kind])
}

// ── Learn modules ─────────────────────────────────────────────────────────────

model Module {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String
  minTier     String           @default("NONE") // NONE|SELF_SERVE|GUIDED|WHITE_GLOVE
  order       Int              @default(0)
  videoUrl    String?
  body        String           // markdown
  status      String           @default("DRAFT") // DRAFT|PUBLISHED
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  progress    ModuleProgress[]
}

model ModuleProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completedAt DateTime  @default(now())

  @@unique([userId, moduleId])
}

// ── Prompt templates ──────────────────────────────────────────────────────────

model PromptTemplate {
  id        String   @id @default(cuid())
  key       String   // plan|digest
  version   Int      @default(1)
  body      String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([key, version])
}

// ── Intake (legacy: keep existing IntakeSubmission for backward compat) ────────

/// Original intake submission table from PR #1 — kept for backward compatibility.
/// New submissions use Intake + Plan models above.
model IntakeSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name          String
  email         String
  role          String
  industry      String
  bizSize       String
  areas         String
  aiComfort     Int
  tools         String
  timeSinks     String
  automateFirst String?
  hoursLost     Int
  preferredHelp String
  freeText      String?
  honeypot      String  @default("")
  ipHash        String?
  llmResponse   String?
  responseType  String?
  emailSent     Boolean @default(false)
}

// ── Audit log ─────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String   // e.g. DOCUMENT_DOWNLOAD, TIER_CHANGE, ROLE_CHANGE
  entity      String   // e.g. Document, Client
  entityId    String?
  meta        String   @default("{}") // JSON
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ── ATG Workbench models ───────────────────────────────────────────────────────

/// A workflow Shea has designed for a client.
model Workflow {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  description String
  area        String    // ea|marketing|sales|cs
  status      String    @default("designing") // designing|building|live|paused
  schedule    String?   // human-readable: "Daily at 6 am MT"
  lastRunAt   DateTime?
  setupNote   String?   // shown as "Set up by Shea" badge text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  runs        WorkflowRun[]
  outputs     OutputItem[]
}

/// One execution of a workflow.
model WorkflowRun {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runAt       DateTime @default(now())
  status      String   @default("completed") // completed|failed|skipped
  summary     String?  // e.g. "3 emails drafted, 1 lead added"
  outputCount Int      @default(0)
}

/// A piece of finished work waiting for the client to review.
model OutputItem {
  id          String    @id @default(cuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String    // briefing|email_draft|lead_list|social_post|quote_followup|review_request
  subject     String
  content     String    // JSON or markdown body
  status      String    @default("pending") // pending|approved|edited|dismissed
  reviewedAt  DateTime?
  editedContent String? // if client edited before approving
  sheaBadge   String?   // e.g. "Reviewed by Shea" or "Set up by Shea"
  createdAt   DateTime  @default(now())
}

/// Thread messages between a client and Shea (admin).
model ClientMessage {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  body       String
  fromAdmin  Boolean  @default(false) // false = from client, true = from Shea
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
}

/// Client requests Shea to build a new workflow.
model WorkflowRequest {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  description String
  status      String   @default("open") // open|acknowledged|designing|done
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Self-serve Tool Plan ───────────────────────────────────────────────────────

/// Personalised tool plan generated for a Self-serve client.
/// Admin reviews and approves before client can view it.
model ToolPlan {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  intakeId     String?
  intake       Intake?   @relation(fields: [intakeId], references: [id])

  status       String    @default("draft") // draft|approved

  /// JSON: [{name, why, costNote}] — tools recommended with reasons and cost note
  toolsJson    String    @default("[]")
  /// JSON: [{order, title, detail}] — ordered setup steps
  stepsJson    String    @default("[]")

  source       String    @default("TEMPLATE") // LLM|TEMPLATE
  adminNotes   String?
  approvedAt   DateTime?
  approvedById String?   // admin User.id

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId])
}

// ── Done-for-you Application ───────────────────────────────────────────────────

/// DFY application / waitlist entry.
model DfyApplication {
  id        String   @id @default(cuid())
  clientId  String   @unique
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  intakeId  String?
  status    String   @default("applied") // applied|waitlisted|accepted|declined
  notes     String?  // admin notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Support Tickets (Self-serve email support) ─────────────────────────────────

model SupportTicket {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    String   @default("open") // open|replied|closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

// ── Client Playbook (admin-only) ──────────────────────────────────────────────

/// Operator playbook Shea uses to run a client engagement.
/// Admin-only — never exposed to clients or the public snapshot.
model ClientPlaybook {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  intakeId     String?
  intake       Intake?   @relation(fields: [intakeId], references: [id])

  version      Int       @default(1)
  status       String    @default("draft") // draft|final

  /// JSON blob matching PlaybookContent Zod schema
  content      String

  source       String    @default("TEMPLATE") // LLM|TEMPLATE
  model        String?
  promptVersion String?

  /// Admin can annotate individual sections
  adminNotes   String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId])
}

// ── Session records (Guided, DFY, discovery calls) ────────────────────────────

model SessionRecord {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  sessionDate   DateTime
  /// discovery | guided | dfy_checkin | other
  sessionType   String
  /// Session N of the Guided package (null for discovery/DFY)
  sessionNumber Int?
  /// Recording URL from AI notetaker or video tool (link only; no audio stored)
  recordingUrl  String?

  /// Client consented to the session being recorded/transcribed
  consentGiven  Boolean  @default(false)

  /// Full transcript text (paste or .txt/.vtt/.srt/.md upload).
  /// Admin-only — never exposed to clients.
  /// Capped at 120 000 characters (~60 000 words).
  transcript    String?

  /// Additional admin-only notes (markdown)
  adminNotes    String?

  /// LLM-generated summary (JSON SessionSummary) — admin-only
  summaryJson   String?
  summarySource String?  // LLM|TEMPLATE

  /// Short recap (2-3 sentences) shared with client when shareRecap=true
  /// Visible only to Guided/DFY clients when shareRecap is true
  shareRecap    Boolean  @default(false)
  recapText     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId, sessionDate])
}
