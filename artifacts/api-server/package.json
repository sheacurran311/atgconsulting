{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "prisma generate && node ./build.mjs",
    "db:push": "prisma db push",
    "test": "node --import tsx --test src/intake.test.ts src/follow-up.test.ts src/tier.test.ts src/playbook.test.ts src/session.test.ts src/stripe.test.ts src/skills.test.ts src/skills2.test.ts src/skills3.test.ts src/dayPlan.test.ts src/install-verify.test.ts src/skill-export.test.ts src/impersonate.test.ts src/seo.test.ts src/catalogHarvest.test.ts src/clientProposal.test.ts",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.82",
    "@clerk/shared": "^4.41.0",
    "@prisma/client": "5.22.0",
    "@types/multer": "^2.3.0",
    "@types/pdf-parse": "^1.1.5",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.0",
    "openai": "^4.104.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "stripe": "^23.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "prisma": "5.22.0",
    "supertest": "^7.3.1",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
