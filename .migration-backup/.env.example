# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, works locally and on Replit)
DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL (swap provider in prisma/schema.prisma to "postgresql"):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/atgconsulting"

# ── LLM provider (choose one) ─────────────────────────────────────────────────
# OpenAI (gpt-4o-mini by default)
OPENAI_API_KEY=
# xAI Grok
XAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
# Together / Fireworks / local Ollama
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# Override model name:
# LLM_MODEL=gpt-4o-mini

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Salt for hashing IPs in submission logs (change to any random string)
IP_HASH_SALT=change-me-in-production

# ── Email (off by default) ────────────────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=
EMAIL_FROM=shea@atgconsulting.io
EMAIL_FROM_NAME=Shea at ATG Consulting
# Shea's email – receives a copy of every submission when EMAIL_ENABLED=true
SHEA_EMAIL=shea@atgconsulting.io

# ── Auth (Replit Auth – see lib/auth.ts) ─────────────────────────────────────
# Set to the Replit user ID for Shea's account (enables admin routes)
ADMIN_REPLIT_ID=
# Local dev mock (set MOCK_USER=1 to simulate a logged-in user without Replit)
MOCK_USER=0
MOCK_USER_ID=dev-user
MOCK_USER_NAME=Dev User
MOCK_USER_ADMIN=0
