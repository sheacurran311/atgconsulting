# ── Database ──────────────────────────────────────────────────────────────────
# Replit: set this to your Replit Postgres URL (from Replit's database panel).
# The schema provider is "postgresql" — a file: URL will be rejected.
# Local dev: temporarily switch schema.prisma provider to "sqlite" and use:
#   DATABASE_URL="file:./artifacts/api-server/prisma/dev.db"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ── Auth (Clerk) ───────────────────────────────────────────────────────────────
# Get these from dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Admin emails (comma-separated). These get role=ADMIN on login.
# Remove an email to demote. Default: shea@atgconsulting.io
ADMIN_EMAILS=shea@atgconsulting.io

# ── LLM (choose one) ──────────────────────────────────────────────────────────
# Without any key, the app uses template fallbacks — fully functional.
# OPENAI_API_KEY — not used; xAI only. Set XAI_API_KEY instead.
XAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1    # only needed for xAI or compatible endpoints
LLM_MODEL=gpt-4o-mini               # override model name

# ── Email (off by default) ────────────────────────────────────────────────────
EMAIL_PROVIDER=console               # console | smtp | resend | postmark
EMAIL_FROM=shea@atgconsulting.io
EMAIL_FROM_NAME=Shea at ATG Consulting
SHEA_EMAIL=shea@atgconsulting.io    # receives intake alerts and admin copies
APP_URL=https://atgconsulting.io

# Email sending flags (all off by default)
EMAIL_SEND_INTAKE_ALERTS=false       # email Shea when a new intake is submitted
EMAIL_SEND_DIGESTS=false             # email clients when a daily digest is published
EMAIL_SEND_PLANS=false               # email clients their plan PDF

# SMTP credentials (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Resend (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# Postmark (if EMAIL_PROVIDER=postmark)
POSTMARK_TOKEN=

# ── Storage ────────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local                 # local | s3 | replit
LOCAL_STORAGE_DIR=./uploads          # for local driver
STORAGE_SIGN_SECRET=change-me-in-production

# S3 / R2 / B2 (if STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=                         # for non-AWS providers (e.g. Cloudflare R2)

# ── Booking ────────────────────────────────────────────────────────────────────
# Cal.com, Calendly, or any booking link. Used in CTAs sitewide.
BOOKING_URL=https://cal.com/shea-atg/30min
# Vite exposes this to the frontend:
VITE_BOOKING_URL=https://cal.com/shea-atg/30min

# ── Social ─────────────────────────────────────────────────────────────────────
VITE_LINKEDIN_URL=https://linkedin.com/in/[shea-linkedin-handle]

# ── Cron ──────────────────────────────────────────────────────────────────────
# Protect the daily-report cron endpoint. Set a long random string.
CRON_SECRET=change-me-set-a-long-random-secret
REPORTS_AUTOPUBLISH=false            # true = publish without admin review

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Leave blank to auto-allow
# *.replit.dev, *.replit.app, and localhost. Required for credentialed requests.
ALLOWED_ORIGINS=

# ── Vite dev proxy ────────────────────────────────────────────────────────────
# When the frontend and API run on different ports/domains, set this to the API
# server URL (e.g. http://localhost:3001 or your Replit API workflow URL).
# The Vite dev server will proxy /api/* requests to this target.
# In Replit: set VITE_PROXY_TARGET in Secrets to the API Server workflow URL.
VITE_PROXY_TARGET=

# ── Security ──────────────────────────────────────────────────────────────────
IP_HASH_SALT=change-me-in-production  # salt for hashing IPs in audit logs

# ── Billing (disabled) ────────────────────────────────────────────────────────
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_SELF_SERVE=
# STRIPE_PRICE_GUIDED=
# STRIPE_PRICE_WHITE_GLOVE=

# ── AI Assist ──────────────────────────────────────────────────────────────────
# Global kill switch. Set to "true" to enable all 4 AI Assist features.
AI_ASSIST_ENABLED=false

# Model selection (cheapest suitable Grok model by default)
AI_MODEL_DEFAULT=grok-4.7
AI_MODEL_VISION=grok-4.7

# Monthly token caps by tier (set conservatively; raise as needed)
AI_CAP_SELF_SERVE=250000
AI_CAP_GUIDED=750000
AI_CAP_DFY=2000000

# Per-minute rate limit per client
AI_RATE_LIMIT_PER_MIN=5

# Chat log retention in days (default 30)
AI_CHAT_LOG_RETENTION_DAYS=30

# Token price estimates for the admin cost table (per 1 000 tokens, USD)
# Check your xAI billing for actual rates; these are estimates only.
AI_TOKEN_PRICE_INPUT=0.002
AI_TOKEN_PRICE_OUTPUT=0.006

# ── Legal pages ────────────────────────────────────────────────────────────────
# Set to "true" after all [PLACEHOLDER] items in legal/*.md are filled in
# and the documents have been reviewed by a Colorado attorney.
# When false (default): pages show a draft banner and are noindexed.
VITE_LEGAL_PUBLISHED=false

# ── Discovery intake ───────────────────────────────────────────────────────────
# Set to "false" to disable the /intake page and all discovery routes.
INTAKE_ENABLED=true

# Per-session token cap for adaptive discovery intake AI calls.
AI_CAP_INTAKE=60000
