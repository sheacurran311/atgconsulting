# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for dev and Replit). Switch to postgresql:// for Neon/Supabase.
DATABASE_URL="file:./artifacts/api-server/prisma/intake.db"

# ── Auth (Clerk) ───────────────────────────────────────────────────────────────
# Get these from dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Admin emails (comma-separated). These get role=ADMIN on login.
# Remove an email to demote. Default: shea@atgconsulting.io
ADMIN_EMAILS=shea@atgconsulting.io

# ── LLM (choose one) ──────────────────────────────────────────────────────────
# Without any key, the app uses template fallbacks — fully functional.
OPENAI_API_KEY=
XAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1    # only needed for xAI or compatible endpoints
LLM_MODEL=gpt-4o-mini               # override model name

# ── Email (off by default) ────────────────────────────────────────────────────
EMAIL_PROVIDER=console               # console | smtp | resend | postmark
EMAIL_FROM=shea@atgconsulting.io
EMAIL_FROM_NAME=Shea at ATG Consulting
SHEA_EMAIL=shea@atgconsulting.io    # receives intake alerts and admin copies
APP_URL=https://atgconsulting.io

# Email sending flags (all off by default)
EMAIL_SEND_INTAKE_ALERTS=false       # email Shea when a new intake is submitted
EMAIL_SEND_DIGESTS=false             # email clients when a daily digest is published
EMAIL_SEND_PLANS=false               # email clients their plan PDF

# SMTP credentials (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Resend (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# Postmark (if EMAIL_PROVIDER=postmark)
POSTMARK_TOKEN=

# ── Storage ────────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local                 # local | s3 | replit
LOCAL_STORAGE_DIR=./uploads          # for local driver
STORAGE_SIGN_SECRET=change-me-in-production

# S3 / R2 / B2 (if STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=                         # for non-AWS providers (e.g. Cloudflare R2)

# ── Booking ────────────────────────────────────────────────────────────────────
# Cal.com, Calendly, or any booking link. Used in CTAs sitewide.
BOOKING_URL=https://cal.com/shea-atg/30min
# Vite exposes this to the frontend:
VITE_BOOKING_URL=https://cal.com/shea-atg/30min

# ── Social ─────────────────────────────────────────────────────────────────────
VITE_LINKEDIN_URL=https://linkedin.com/in/[shea-linkedin-handle]

# ── Cron ──────────────────────────────────────────────────────────────────────
# Protect the daily-report cron endpoint. Set a long random string.
CRON_SECRET=change-me-set-a-long-random-secret
REPORTS_AUTOPUBLISH=false            # true = publish without admin review

# ── Security ──────────────────────────────────────────────────────────────────
IP_HASH_SALT=change-me-in-production  # salt for hashing IPs in audit logs

# ── Billing (disabled) ────────────────────────────────────────────────────────
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_SELF_SERVE=
# STRIPE_PRICE_GUIDED=
# STRIPE_PRICE_WHITE_GLOVE=
